# Copie para .env.local e preencha. Nenhuma variável é obrigatória para o site funcionar.

# URL pública do site (usada nos links enviados por WhatsApp/e-mail e no sitemap)
NEXT_PUBLIC_SITE_URL=https://lndinformatica.com.br

# Painel /admin e rotas /api/admin/* — use uma chave longa e aleatória (mín. 16 caracteres).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LND_ADMIN_TOKEN=

# Onde os contatos e orçamentos são gravados (JSON). Padrão: ./.data
# Em hospedagem com disco efêmero, aponte para um volume persistente.
LND_DATA_DIR=

# Aviso de novo contato por e-mail (https://resend.com — plano gratuito atende bem)
RESEND_API_KEY=
LND_NOTIFY_EMAIL_TO=leonardo@lnd.inf.br
LND_NOTIFY_EMAIL_FROM=Site LND <site@lndinformatica.com.br>

# Aviso por webhook (Slack, Discord, n8n, Make, Zapier…) — recebe um POST JSON
LND_WEBHOOK_URL=

# Outras origens autorizadas a enviar formulários (separadas por vírgula), além do próprio domínio
LND_ALLOWED_ORIGINS=
