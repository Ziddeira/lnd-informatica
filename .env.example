# Copie para .env.local e preencha. Nenhuma variável é obrigatória para o site funcionar.

# URL pública do site (links no WhatsApp/e-mail, sitemap e metadados).
# Na Vercel pode ficar vazia: o domínio de produção do projeto é usado automaticamente.
NEXT_PUBLIC_SITE_URL=

# Painel /admin e rotas /api/admin/* — use uma chave longa e aleatória (mín. 16 caracteres).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LND_ADMIN_TOKEN=

# Armazenamento dos contatos e orçamentos.
# Na Vercel: Storage → Upstash (Redis) → Connect — as variáveis KV_REST_API_URL e KV_REST_API_TOKEN
# são criadas sozinhas e o site passa a usar o Redis automaticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (ou UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, se criar o banco direto no upstash.com)

# Em servidor próprio, sem Redis: pasta dos arquivos JSON. Padrão: ./.data
LND_DATA_DIR=

# Aviso de novo contato por e-mail (https://resend.com — plano gratuito atende bem)
RESEND_API_KEY=
LND_NOTIFY_EMAIL_TO=leonardo@lnd.inf.br
LND_NOTIFY_EMAIL_FROM=Site LND <site@lndinformatica.com.br>

# Aviso por webhook (Slack, Discord, n8n, Make, Zapier…) — recebe um POST JSON
LND_WEBHOOK_URL=

# Outras origens autorizadas a enviar formulários (separadas por vírgula), além do próprio domínio
LND_ALLOWED_ORIGINS=
